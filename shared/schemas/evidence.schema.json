{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence",
  "type": "object",
  "required": ["evidence_id", "type"],
  "properties": {
    "evidence_id": { "type": "string", "pattern": "^EVD[A-Z0-9]+$" },
    "incident_id": { "type": "string", "pattern": "^INC[A-Z0-9]+$" },
    "type": {
      "type": "string",
      "enum": ["image", "bank_sms", "chat_screenshot", "audio", "document", "video", "other"]
    },
    "original_filename": { "type": ["string", "null"] },
    "sha256_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "notes": { "type": ["string", "null"] },
    "created_at": { "type": ["string", "null"], "format": "date-time" }
  }
}