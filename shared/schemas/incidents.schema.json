{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Incident",
  "type": "object",
  "required": ["incident_id", "user_id", "description", "date", "categories"],
  "properties": {
    "incident_id": { "type": "string", "pattern": "^INC[A-Z0-9]+$" },
    "user_id": { "type": "string", "pattern": "^USR[A-Z0-9]+$" },
    "description": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": ["string", "null"], "pattern": "^\\d{2}:\\d{2}$" },
    "location": { "type": ["string", "null"] },
    "people_involved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": { "type": "string" },
          "name": { "type": ["string", "null"] }
        }
      }
    },
    "categories": {
      "type": "object",
      "required": ["physical", "economic", "digital"],
      "properties": {
        "physical": { "type": "boolean" },
        "economic": { "type": "boolean" },
        "digital": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "evidence.schema.json" }
    },
    "economic_details": {
      "type": "object",
      "properties": {
        "money_controlled": { "type": ["boolean", "null"] },
        "card_withheld": { "type": ["boolean", "null"] },
        "amount": { "type": ["string", "number", "null"] }
      }
    },
    "digital_details": {
      "type": "object",
      "properties": {
        "platform": { "type": ["string", "null"] },
        "private_content_threat": { "type": ["boolean", "null"] }
      }
    },
    "ai_classification": {
      "type": ["object", "null"],
      "properties": {
        "tags": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "type": "string" }
      }
    },
    "created_at": { "type": ["string", "null"], "format": "date-time" }
  }
}